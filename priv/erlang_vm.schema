%%-*- mode: erlang -*-
%%
%% Schema for common OTP-21+ emulator options.
%%

%% -------------------------------------------------------------------
%% Runtime Flags
%% -------------------------------------------------------------------

%% @doc Name of the Erlang node
{mapping, "nodename", "vm_args.-name", [
    {datatype, atom},
    {default, "{{node}}"}
]}.

%% @doc Cookie for distributed node communication.
%% All nodes in a distributed cluster should use the same cookie or they will
%% not be able to communicate.
%%
%% Note that setting the cookie in this manner is discouraged, and this
%% configuration key is supported only for backward compatibility.
%% Instead, the cookie should be stored in the ~/.erlang.cookie file with
%% restricted read access.
%%
%% Cuttlefish issues a warning message if this key is set.
%%
%% See: https://www.erlang.org/doc/system/distributed.html#security
{mapping, "distributed_cookie", "vm_args.-setcookie", [
    {datatype, atom},
    {commented, erlang}
]}.

%% @doc Sets the location of crash dumps.
{mapping, "erlang.crash_dump", "vm_args.-env ERL_CRASH_DUMP", [
    {datatype, file},
    {default, "{{crash_dump}}"},
    hidden
]}.

%% @doc A non-negative integer which indicates how many times per-process
%% generational garbage collections can be done without forcing a fullsweep
%% collection.
%%
%% In low-memory systems (especially without virtual memory), setting the
%% value to 0 can help to conserve memory at the expense of more frequent
%% garbage collection.
%%
%% Default: 65535
%%
%% See: https://www.erlang.org/doc/apps/erts/erlang#system_info_fullsweep_after
%% See: https://www.erlang.org/doc/apps/erts/erlang.html#system_flag/2
{mapping, "erlang.fullsweep_after", "vm_args.-env ERL_FULLSWEEP_AFTER", [
    {datatype, integer},
    {validators, [non_neg_integer]},
    {commented, 0}
]}.

%% -------------------------------------------------------------------
%% Emulator Flags
%% Ordered as in https://www.erlang.org/doc/man/erl#emulator-flags
%% -------------------------------------------------------------------

%% @doc Suggested stack size, in bytes, for threads in the async-thread pool.
%% Valid range is 16-8192 kilowords. Note that the value passed is only a
%% suggestion, and it might even be ignored on some platforms.
%%
%% See: https://www.erlang.org/doc/man/erl#async_thread_stack_size
{mapping, "erlang.async_threads.stack_size", "vm_args.+a", [
    {datatype, bytesize},
    {validators, [wordsize_multiple, {kiloword_range, [16, 8192]}]},
    hidden
]}.

{translation, "vm_args.+a",
    fun(Conf) ->
        io:format(user, "~nTranslation: ~tp~n", [Conf]),
        KiloWord = cutlefish_validators:integer_value(kiloword),
io:format(user, "~KiloWord: ~tp~n", [KiloWord]),
        ByteSize = cuttlefish:conf_get("erlang.async_threads.stack_size", Conf),
io:format(user, "~ByteSize: ~tp~n", [ByteSize]),
        (ByteSize div KiloWord)
    end
}.

%% @doc Sets the number of threads in async thread pool.
%% Valid range is 1-1024.
%%
%% Since OTP 21 use of the async thread pool is largely obsolete.
%%
%% Default: 1.
%%
%% See: https://www.erlang.org/doc/man/erl#async_thread_pool_size
{mapping, "erlang.async_threads", "vm_args.+A", [
    {datatype, integer},
    {validators, [{integer_range, [1, 1024]}]},
    {commented, 1}
]}.

%% @doc Specifies how the emulator shell responds to Ctrl-C interrupts.
%% Option 'c' makes Ctrl-C interrupt the current shell instead of invoking the
%% emulator break handler.
%% Option 'd' disables the break handler.
%% Option 'i' makes the emulator ignore any break signal.
%%
%% See: https://www.erlang.org/doc/man/erl#emulator-flags
{mapping, "erlang.break_handler", "vm_args.+B", [
    {datatype, {enum, [c, d, i]}},
    hidden
]}.

%% @doc Enables or disables time correction.
%%
%% Default: on
%%
%% See: https://www.erlang.org/doc/apps/erts/time_correction#time-correction
%% @see erlang.time_warp_mode
{mapping, "erlang.time_correction", "vm_args.+c", [
    {datatype, flag},
    {commented, on}
]}.

%% @doc Sets time warp mode.
%% Option 'no_time_warp': The time offset is determined at runtime system start
%%  and does not change later.
%% Option 'single_time_warp': This is more or less a backward compatibility
%%  mode as from its introduction.
%% Option 'multi_time_warp': Multi-time warp mode in combination with time
%%  correction is the preferred configuration.
%%
%% Default: 'no_time_warp' through OTP 25, 'multi_time_warp' from OTP 26.
%%
%% See: https://www.erlang.org/doc/apps/erts/time_correction#time-warp-modes
%% @see erlang.time_correction
{mapping, "erlang.time_warp_mode", "vm_args.+C", [
    {datatype, {enum, [no_time_warp, single_time_warp, multi_time_warp]}},
    {commented, multi_time_warp}
]}.

%% @doc Sets the maximum number of expected ETS tables.
%% This limit is partially obsolete, now serving as an optimization hint.
%% If large amounts of named tables are used and this value hasn't been
%% increased, the performance of named table lookup will degrade.
%%
%% Default: around 1400 tables.
%%
%% See: https://www.erlang.org/doc/apps/stdlib/ets#max_ets_tables
{mapping, "erlang.max_ets_tables", "vm_args.+e", [
    {datatype, integer},
    {validators, [pos_integer]},
    hidden
]}.

%% @doc Sets the range of characters that the system considers printable in
%% heuristic detection of strings.
%% This typically affects terms containing unicode characters written to the
%% terminal and log files.
%%
%% Default: latin1
%%
%% See: https://www.erlang.org/doc/apps/erts/erl_cmd.html#emulator-flags
%% See: https://www.erlang.org/doc/apps/stdlib/io#printable_range/0
{mapping, "erlang.printable_range", "vm_args.+pc", [
    {datatype, {enum, [latin1, unicode]}},
    {commented, unicode}
]}.

%% @doc Sets the maximum number of simultaneous processes.
%% Valid range is 1024-134217727 (2^27-1).
%%
%% The actual maximum chosen may be larger than the value specified here.
%% The runtime system generally chooses a value that is a power of 2.
%%
%% Default: 262144 through OTP 26, 1048576 from OTP 27.
%%
%% See:
%%  https://www.erlang.org/doc/apps/erts/erl_cmd.html#emulator-flags
%%  https://www.erlang.org/doc/apps/erts/erlang#system_info_process_limit
{mapping, "erlang.process_limit", "vm_args.+P", [
    {datatype, integer},
    {validators, [{integer_range, [1024, 134217727]}]},
    {commented, 1048576}
]}.

%% @doc Sets the maximum number of simultaneously open files/ports/sockets.
%% Valid range is 1024-134217727 (2^27-1).
%%
%% The actual maximum chosen may be larger than the value specified here.
%% The runtime system generally chooses a value that is a power of 2.
%% The default is normally 65536, but may be higher if the VM determines
%% more open file descriptors are allowed.
%%
%% See:
%%  https://www.erlang.org/doc/apps/erts/erl_cmd.html#emulator-flags
%%  https://www.erlang.org/doc/apps/erts/erlang#system_info_port_limit
{mapping, "erlang.max_ports", "vm_args.+Q", [
    {datatype, integer},
    {validators, [{integer_range, [1024, 134217727]}]},
    {commented, 65536}
]}.

%% @doc Sets the number of scheduler threads to create and set online.
%%
%% Format is "Total:Online" where Total and Online are as described for
%% erlang.schedulers.total and erlang.schedulers.online, respectively.
%% Additionally, if Total and Online are both > zero then Total must be
%% >= Online.
%%
%% This setting allows configuring erlang.schedulers.total and
%% erlang.schedulers.online together so that their relationship can be
%% validated, and takes precedence over their settings if present.
%%
%% @see erlang.schedulers.total
%% @see erlang.schedulers.online
{mapping, "erlang.schedulers", "vm_args.+S", [
    {datatype, string},
    {validators, [schedulers_combined]},
    {commented, "0:0"}
]}.

%% @doc Sets the number of scheduler threads to create.
%% Valid range is (0 - LCPUs + 1)..1024.
%%
%% Defaults to logical processors (LCPUs) configured in the system, or 1 if
%% the VM can't determine the LCPU count.
%% If specified as a negative number the value is subtracted from the
%% configured LCPUs. If specified as zero sets the calculated default.
%%
%% You CAN set this value higher than the actual number of LCPUs, but you
%% almost certainly shouldn't.
%%
%% The number of scheduler threads is determined at VM boot time and cannot
%% be changed subsequently.
%%
%% See: https://www.erlang.org/doc/apps/erts/erl_cmd.html#+S
%% See: https://www.erlang.org/doc/apps/erts/erlang#system_info_schedulers
%% @see erlang.schedulers
%% @see erlang.schedulers.online
{mapping, "erlang.schedulers.total", "vm_args.+S", [
    {datatype, integer},
    {validators, [schedulers_total]},
    {commented, 0}
]}.

%% @doc Sets the number of scheduler threads to set online.
%% Valid range is (0 - LCPUs + 1)..1024.
%%
%% Defaults to logical processors (LCPUs) available in the system, subject to
%% any detected CPU quota, or 1 if the VM can't determine the LCPU count.
%% If specified as a negative number the value is subtracted from the available
%% LCPUs. If specified as zero sets the calculated default.
%%
%% If specified the value must be <= the effective value of
%% erlang.schedulers.total.
%%
%% See: https://www.erlang.org/doc/apps/erts/erl_cmd.html#+S
%% See: https://www.erlang.org/doc/apps/erts/erlang#system_info_schedulers_online
%% See: https://www.erlang.org/doc/apps/erts/erlang#system_info_cpu_quota
%% See: https://www.erlang.org/doc/apps/erts/erlang#system_flag_schedulers_online
%% @see erlang.schedulers
%% @see erlang.schedulers.total
{mapping, "erlang.schedulers.online", "vm_args.+S", [
    {datatype, integer},
    {validators, [schedulers_online]},
    {commented, 0}
]}.

%% @doc Similar to erlang.schedulers but uses percentages to set the number
%% of schedulers.
%%
%% Format is "Total:Online" where Total and Online are percentages in the
%% range 1..100, relative to the effective values of erlang.schedulers.total
%% and erlang.schedulers.online.
%%
%% See: https://www.erlang.org/doc/apps/erts/erl_cmd.html#+SP
%% @see erlang.schedulers
{mapping, "erlang.schedulers.percent", "vm_args.+SP", [
    {datatype, string},
    {validators, [scheduler_percent]},
    {commented, "100:100"}
]}.

%% @doc Enable or disable scheduler compaction of load. By default
%% scheduler compaction of load is enabled. When enabled, load
%% balancing will strive for a load distribution which causes as many
%% scheduler threads as possible to be fully loaded (i.e., not run out
%% of work). This is accomplished by migrating load (e.g. runnable
%% processes) into a smaller set of schedulers when schedulers
%% frequently run out of work. When disabled, the frequency with which
%% schedulers run out of work will not be taken into account by the
%% load balancing logic.
%%
%% See: https://www.erlang.org/doc/apps/erts/erl_cmd.html#+scl
%% @see erlang.schedulers.utilization_balancing
{mapping, "erlang.schedulers.compaction_of_load", "vm_args.+scl", [
    {datatype, flag},
    {commented, off}
]}.

%% @doc Enable or disable scheduler utilization balancing of load. By
%% default scheduler utilization balancing is disabled and instead
%% scheduler compaction of load is enabled which will strive for a
%% load distribution which causes as many scheduler threads as
%% possible to be fully loaded (i.e., not run out of work). When
%% scheduler utilization balancing is enabled the system will instead
%% try to balance scheduler utilization between schedulers. That is,
%% strive for equal scheduler utilization on all schedulers.
%%
%% See: https://www.erlang.org/doc/apps/erts/erl_cmd.html#+sub
%% @see erlang.schedulers.compaction_of_load
{mapping, "erlang.schedulers.utilization_balancing", "vm_args.+sub", [
    {datatype, flag},
    {commented, on}
]}.

%% @doc Sets the maximum number of atoms the virtual machine can handle.
%%
%% Default: 1,048,576
%%
%% See: https://www.erlang.org/doc/apps/erts/erl_cmd.html#emulator-flags
{mapping, "erlang.atom_table_limit", "vm_args.+t", [
    {datatype, integer},
    {commented, 1048576},
    hidden
]}.

%% @doc Sets the mapping of warning messages for 'error_logger'.
%% Messages sent to the error logger using one of the warning routines can be
%% mapped either to errors (e), warnings (w - default), or info reports (i).
%%
%% Use of the kernel 'error_logger' is largely obsolete, replaced by the
%% 'logger' subsystem. As such, this setting is likely to be hidden or
%% deprecated in the future.
%%
%% Default: w
%%
%% See: https://www.erlang.org/doc/apps/erts/erl_cmd.html#emulator-flags
%% See: https://www.erlang.org/doc/apps/kernel/error_logger#warning_map/0
{mapping, "erlang.warning_map", "vm_args.+W", [
    {datatype, {enum, [e, i, w]}},
    {commented, w}
]}.

%% @doc Distribution Buffer Busy Limit.
%% Sets the sender-side network distribution buffer size, in kilobytes per
%% channel (remote node).
%% Valid range is 1KB through 2GB-1KB.
%%
%% For nodes receiving busy_dist_port events, a higher limit improves latency
%% and throughput at the expense of higher memory use.
%% Multiply by cluster size for total per-node usage.
%%
%% Since OTP 25 the behavior of this limit may be altered by processes that
%% have enabled fully asynchronous distributed signaling.
%%
%% Default: 1MB
%%
%% See: https://www.erlang.org/doc/apps/erts/erl_cmd#+zdbbl
%% See: https://www.erlang.org/doc/apps/erts/erlang#process_flag_async_dist
{mapping, "erlang.distribution_buffer_size", "vm_args.+zdbbl", [
    {datatype, bytesize},
    {validators, [
        {integer_compare, [mult, kilobyte]},
        {kilobyte_range,  [1, 2097151]}
    ]},
    {commented, "32MB"}
]}.

{translation, "vm_args.+zdbbl",
    fun(Conf) ->
        case cuttlefish:conf_get(
                "erlang.distribution_buffer_size", Conf, undefined) of
            Bytes when erlang:is_integer(Bytes) ->
                (Bytes div 1024);
            _ ->
                undefined
        end
    end
}.

%% -------------------------------------------------------------------
%% Kernel application settings
%% -------------------------------------------------------------------

%% @doc For ease of firewall configuration, the Erlang distribution
%% can be bound to a limited range of TCP ports. If this is set, and
%% erlang.distribution.port_range.maximum is *unset*, only this port
%% will be used. If the minimum is *unset*, no restriction will be
%% made on the port range; instead Erlang will listen on a random
%% high-numbered port.
%%
%% See: https://www.erlang.org/doc/apps/kernel/kernel_app.html#inet_dist_listen
%% @see erlang.distribution.port_range.maximum
{mapping, "erlang.distribution.port_range.minimum", "kernel.inet_dist_listen_min", [
    {datatype, integer},
    {validators, [port_number]},
    {commented, 6000}
]}.

%% @doc Works with 'erlang.distribution.port_range.minimum' to constrain the
%% range of ports that Erlang may choose to listen on.
%% See: https://www.erlang.org/doc/apps/kernel/kernel_app.html#inet_dist_listen
%% @see erlang.distribution.port_range.minimum
{mapping, "erlang.distribution.port_range.maximum", "kernel.inet_dist_listen_max", [
    {datatype, integer},
    {validators, [port_number]},
    {commented, 7999}
]}.

%% @doc Set the interface/IP to listen for distributed Erlang connections.
%%
%% See: https://www.erlang.org/doc/apps/kernel/kernel_app.html#inet_dist_use_interface
{mapping, "erlang.distribution.interface", "kernel.inet_dist_use_interface", [
    {datatype, string},
    {validators, [ip_strict]}
]}.

{translation, "kernel.inet_dist_use_interface",
    fun(Conf) ->
        IPStr = cuttlefish:conf_get("erlang.distribution.interface", Conf),
        {ok, IP_address} = inet:parse_strict_address(IPStr),
        IP_address
    end
}.

%% @doc Specifies the kernel's "net tick time" in seconds.
%% This is the approximate time a connected node may be unresponsive before
%% it is considered down and thereby disconnected.
%%
%% Default: 60
%%
%% See: https://www.erlang.org/doc/apps/kernel/kernel_app.html#net_ticktime
{mapping, "erlang.distribution.net_ticktime", "kernel.net_ticktime", [
    {datatype, integer},
    {commented, 60},
    hidden
]}.

%% -------------------------------------------------------------------
%% Deprecated options.
%% -------------------------------------------------------------------

%% @doc Set scheduler forced wakeup interval. All run queues will be
%% scanned each Interval milliseconds. While there are sleeping
%% schedulers in the system, one scheduler will be woken for each
%% non-empty run queue found. An Interval of zero disables this
%% feature, which also is the default.
%%
%% This feature is a workaround for lengthy executing native code, and
%% native code that does not bump reductions properly. It is slated for
%% removal in a future version, and should be avoided where possible.
%%
%% Default: 0
%%
%% See: https://www.erlang.org/doc/apps/erts/erl_cmd.html#+sfwi
{mapping, "erlang.schedulers.force_wakeup_interval", "vm_args.+sfwi", [
    {datatype, integer},
    deprecated
]}.

%% @doc Deprecated, use 'erlang.warning_map'.
{mapping, "erlang.W", "vm_args.+W", [
    {datatype, {enum, [e, i, w]}},
    {deprecated,
        "Use 'erlang.warning_map' instead. Expect removal in 2026."}
]}.

%% -------------------------------------------------------------------
%% Obsolete options.
%% -------------------------------------------------------------------

%% @doc No longer a recognized switch, strip from config.
{mapping, "erlang.smp", "vm_args.-smp", [
    {datatype, {enum, [enable, auto, disable]}},
    obsolete
]}.

%% @doc No longer a recognized switch, strip from config.
{mapping, "erlang.K", "vm_args.+K", [
    {datatype, flag},
    obsolete
]}.
